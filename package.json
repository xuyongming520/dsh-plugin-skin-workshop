{
  "name": "@local/violet-skin",
  "version": "2.7.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Skin Workshop: independently mix native or styled themes, wallpaper, panel materials and reading protection; preview, save and share complete recipes.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/workshop.browser.mjs",
    "test:native-browser": "node tests/native-shell.browser.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/dsh-client-ui-theme": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js", "client.js", "cordis.patch.yml", "README.md",
    "src", "scripts", "tests", "examples", "locale/*.json", "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
